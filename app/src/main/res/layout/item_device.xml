<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp">


    <RelativeLayout
        android:layout_centerVertical="true"
        android:id="@+id/connectView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            />

        <ImageView
            android:id="@+id/connectImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/inno_connect_icon"
            />




    </RelativeLayout>

    <TextView
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_toRightOf="@+id/connectView"
        android:fontFamily="@font/custom_font"
        android:textFontWeight="600"
        android:id="@+id/deviceNameText"
        android:layout_width="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_toLeftOf="@+id/deviceState"
        android:layout_height="wrap_content"
        tools:text="deviceName"
        android:textSize="18sp"
        android:textColor="@color/black2" />


    <TextView
        android:layout_centerVertical="true"
        android:fontFamily="@font/custom_font"
        android:textFontWeight="500"
        android:layout_alignParentRight="true"
        android:id="@+id/deviceState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="v.101.222"
        android:textSize="16sp"
        android:textColor="@color/black2" />

</RelativeLayout>
