<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        tools:ignore="UselessParent">


        <LinearLayout
            android:id="@+id/overallScoreLayout"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A75CCFD"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:fontFamily="@font/custom_font"
                    android:textFontWeight="500"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/overall_score"
                    android:textColor="#0061F2"
                    android:textSize="14sp" />


                <TextView
                    android:fontFamily="@font/custom_font"
                    android:textFontWeight="600"
                    android:id="@+id/byCycleOverallScoreTextview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="82"
                    android:textColor="#0061F2"
                    android:textSize="28sp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/chestScoreByCycle"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chestScoreByCycleTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:paddingStart="20dp"
                        android:text="Compression Depth"
                        android:textColor="#333333"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600"
                        android:textSize="20sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleCompressionDepthScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/custom_font"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="0%"
                        android:textColor="#D9D9D9"
                        android:textFontWeight="500"
                        android:textSize="20sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/compReleaseByCycleTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingStart="20dp"
                        android:paddingBottom="20dp"
                        android:text="Compression Release"
                        android:textColor="#333333"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600"
                        android:textSize="20sp"
                        />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleCompressionReleaseScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="0%"
                        android:textColor="#D9D9D9"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="500"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/byCycleCompressionRateTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingStart="20dp"
                        android:paddingBottom="20dp"
                        android:text="Compression Rate"
                        android:textColor="#333333"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600"
                        android:textSize="20sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleCompressionRateScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="0%"
                        android:textColor="#D9D9D9"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="500"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/cprScoreHandPostionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingStart="20dp"
                        android:paddingBottom="20dp"
                        android:text="Hand Position"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleHandPositionScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="0%"
                        android:textFontWeight="500"
                        android:textColor="#D9D9D9"
                        android:textSize="20sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/byCycleCompressionFractionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingStart="20dp"
                        android:paddingBottom="20dp"
                        android:text="Compression Fraction"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleCompressionFractionScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="0%"
                        android:textColor="#D9D9D9"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="500"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/scoreByCycleCompCountLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/byCycleNoCompressionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingStart="20dp"
                        android:paddingBottom="20dp"
                        android:text="Compression Count"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600"  />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleNoCompressionScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="500"
                        android:paddingBottom="20dp"
                        android:text="0%"
                        android:textColor="#D9D9D9"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ventScoreByCycle"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/byCycleVentilationVolumeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingStart="20dp"
                        android:paddingBottom="20dp"
                        android:text="Ventilation Volume"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleVentilationVolumeScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        tools:text="0%"
                        android:textColor="#D9D9D9"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="500"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/byCycleVentCountTextview"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:paddingStart="20dp"
                        android:text="Ventilation Count"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleVentilationRateScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="0%"
                        android:textColor="#D9D9D9"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="500"/>
                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/byCycleVentilationSpeedLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/byCycleVentilationSpeedTitle"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:paddingStart="20dp"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="600"
                        android:text="@string/ventilation_speed"
                      android:layout_width="0dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EEEEEE" />

                    <TextView
                        android:id="@+id/byCycleVentilationSpeedScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="0%"
                        android:textColor="#D9D9D9"
                        android:textSize="20sp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="500" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#eeeeee" />
            </LinearLayout>





        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#eeeeee" />

        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/cycleInfoRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_cycle_history" />

    </LinearLayout>

</LinearLayout>
</layout>