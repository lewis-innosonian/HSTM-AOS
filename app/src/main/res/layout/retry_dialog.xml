<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="780dp"
    android:layout_height="wrap_content"
    android:paddingBottom="65dp"
    android:paddingTop="65dp"
    android:paddingLeft="50dp"
    android:paddingRight="50dp"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded">


    <TextView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculation Failed"
        android:textColor="#333333"
        android:textSize="28dp"
        android:fontFamily="@font/custom_font"
        android:textFontWeight="600"/>

    <TextView
        android:gravity="center"
        android:id="@+id/failReason"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Would you like to try again?"
        android:textColor="#666666"
        android:textSize="24dp"
        android:fontFamily="@font/custom_font"
        android:textFontWeight="400"/>


    <LinearLayout
        android:layout_marginTop="25dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
        android:paddingLeft="122dp"
        android:paddingEnd="122dp"
    >
    <com.example.hstm_aos.customview.RoundedButton
        android:visibility="visible"
        android:id="@+id/no_btn"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="15dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:textColor="@color/white"
        android:fontFamily="@font/custom_font"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rb_bgColor="#666666"
        app:rb_radius="10dp"
        android:textSize="20dp"
        android:text="Confirm"
        />



    <com.example.hstm_aos.customview.RoundedButton
        android:layout_weight="1"
        android:id="@+id/try_again_btn"
        android:layout_gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="15dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="15dp"
        android:textColor="@color/white"
        android:fontFamily="@font/custom_font"
        android:textFontWeight="600"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rb_bgColor="#2072ED"
        app:rb_radius="10dp"
        android:textSize="20dp"
        android:text="Try Again"
        />
</LinearLayout>


</LinearLayout>