<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:gravity="center"
        android:id="@+id/edu_guide_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/custom_font"
        android:textFontWeight="600"
        android:textSize="20sp"
        android:lineSpacingExtra="0dp"
        android:lineSpacingMultiplier="1.0"
        android:includeFontPadding="false"
        android:textColor="@color/black1"
        android:text="Perform 3 cycles of CPR on the manikin"/> <!--TODO 변경 -->

    <TextView
        android:includeFontPadding="false"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/custom_font"
        android:textFontWeight="400"
        android:textSize="16sp"
        android:lineSpacingExtra="0dp"
        android:lineSpacingMultiplier="1.0"
        android:textColor="@color/black2"
        android:text="Your first passing score will be recorded in your transcript."/> <!--TODO 변경 -->


    <LinearLayout
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4.36"

            >
    <com.example.hstm_aos.customview.RoundedLinearLayout
        android:id="@+id/llGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rv_radius="30dp"
        android:orientation="vertical"
        android:gravity="center"
        app:rv_backgroundColor="#F5F5F5">


        <TextView
            android:id="@+id/tvGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/custom_font"
            android:textFontWeight="700"
            android:textSize="65sp"
            android:textColor="@color/black1"
            android:layout_gravity="center"
            android:text="Ready"
            tools:text="READY"/>




    </com.example.hstm_aos.customview.RoundedLinearLayout>

            <TextView
                android:id="@+id/waiting_aed"
                android:visibility="gone"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/custom_font"
                android:textFontWeight="600"
                android:textSize="24sp"
                android:layout_centerHorizontal="true"
                android:textColor="#F85402"
                android:text="Waiting for the AED-T"/>
            <LinearLayout
                android:layout_alignParentBottom="true"
                android:visibility="invisible"
                android:id="@+id/aedContainerLayout"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/turnOnAedLayout"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/turnOnAedImageView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/power_disable"/>

                    <ProgressBar
                        android:clipToPadding="false"
                        android:layout_marginLeft="18dp"
                        android:id="@+id/turnOnAedProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progressDrawable="@drawable/aed_horizntal_progressbar_background"
                        android:max="100"
                        android:progress="0" />
                </LinearLayout>


                <LinearLayout
                    android:layout_marginLeft="18dp"
                    android:id="@+id/pasAedLayout"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/pasAedImageView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/attachpads_disable"/>

                    <ProgressBar
                        android:layout_marginLeft="18dp"
                        android:id="@+id/pasAedProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progressDrawable="@drawable/aed_horizntal_progressbar_background"
                        android:max="100"
                        android:progress="0" />
                </LinearLayout>


                <LinearLayout
                    android:layout_marginLeft="18dp"
                    android:id="@+id/analyzingHeartRhythmAedLayout"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/analyzingHeartRhythmAedImageView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/analyzing_disable"/>

                    <ProgressBar
                        android:layout_marginLeft="18dp"
                        android:id="@+id/analyzingHeartRhythmAedprogressBar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progressDrawable="@drawable/aed_horizntal_progressbar_background"
                        android:max="100"
                        android:progress="0" />
                </LinearLayout>



                <LinearLayout
                    android:layout_marginLeft="18dp"
                    android:id="@+id/shockAedLayout"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/shockImageView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/question_mark_disable"/>

                    <ProgressBar
                        android:layout_marginLeft="18dp"
                        android:id="@+id/shockProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progressDrawable="@drawable/aed_horizntal_progressbar_background"
                        android:max="100"
                        android:progress="0" />

                </LinearLayout>



                <ImageView
                    android:layout_marginLeft="18dp"
                    android:id="@+id/cprImageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/start_cpr_disable"/>


            </LinearLayout>


        </RelativeLayout>

        <com.example.hstm_aos.customview.RoundedLinearLayout
            android:layout_width="wrap_content"

            android:layout_marginTop="18dp"
            android:layout_gravity="center"
            android:paddingEnd="60dp"
            android:layout_height="0dp"
            app:rv_radius="30dp"
            app:rv_borderColor="#333333"
            app:rv_borderWidth="1dp"
            android:layout_weight="1">

        <com.example.hstm_aos.customview.RoundedLinearLayout
            android:layout_marginEnd="50dp"
            android:gravity="center"
            android:layout_width="250dp"
            android:layout_gravity="center"
            android:layout_height="match_parent"
            app:rv_radius="30dp"
            app:rv_backgroundColor="#333333"
            app:rv_borderWidth="1dp"
            >

            <TextView
                android:id="@+id/tvCycleCount"
                android:fontFamily="@font/custom_font"
                android:textFontWeight="700"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cycle 0"/>
        </com.example.hstm_aos.customview.RoundedLinearLayout>


            <LinearLayout

                android:id="@+id/compCountLayout"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/inno_comp_icon_24"/>

                <TextView
                    android:id="@+id/tvCompressionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/custom_font"
                    android:textFontWeight="700"
                    android:textSize="20sp"
                    android:textColor="@color/black1"
                    android:text="0/30"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/ventCountTextView"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/inno_vent_icon_24" />

                <TextView
                    android:id="@+id/tvVentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/custom_font"
                    android:text="0/2"
                    android:textColor="@color/black1"
                    android:textFontWeight="700"
                    android:textSize="20sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/inno_timer_icon" />

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/custom_font"
                    android:text="00:00"
                    android:textColor="@color/black1"
                    android:textFontWeight="700"
                    android:textSize="20sp" />

            </LinearLayout>

        </com.example.hstm_aos.customview.RoundedLinearLayout>


        <LinearLayout
            android:layout_marginTop="15dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7.31">




            <com.example.hstm_aos.customview.RoundedLinearLayout
                android:padding="30dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:rv_radius="40dp"
                app:rv_borderColor="#EEEEEE"
                app:rv_borderWidth="1dp">


                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"

                    android:layout_height="match_parent"
                    android:minWidth="240dp"
                    >

                    <TextView
                        android:id="@+id/positionTextView"
                        android:gravity="center"
                        android:drawableStart="@drawable/inno_position_icon_17"
                        android:drawablePadding="6dp"
                        android:layout_gravity="center"
                        android:textColor="@color/black2"
                        android:textSize="18dp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="700"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Position"/>
                    <com.example.hstm_aos.customview.CustomHandPositionView
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:id="@+id/hand_position_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        />

                </LinearLayout>



                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="2.1"
                    android:layout_marginStart="30dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- HEADER -->
                    <LinearLayout
                        android:id="@+id/timeSeriesRelativeLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/depthRateImage"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/inno_timer_icon" />

                        <TextView
                            android:id="@+id/depthRateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Depth &amp; Rate"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- CHART AREA -->
                    <com.example.hstm_aos.customview.CustomRelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@id/timeSeriesRelativeLayout"
                        android:layout_marginTop="10dp">

                        <!-- SCROLL -->
                        <com.example.hstm_aos.customview.CustomHorizontalScrollView
                            android:id="@+id/chartScrollView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fillViewport="false"
                            android:scrollbars="none">

                            <!-- CHART -->
                            <com.example.hstm_aos.customview.DualBarChartView
                                android:id="@+id/dualBarChartView"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent" />
                        </com.example.hstm_aos.customview.CustomHorizontalScrollView>

                        <!-- TITLE OVERLAY -->
                        <com.example.hstm_aos.customview.DualBarChartTitleView
                            android:id="@+id/dualBarChartTitleView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </com.example.hstm_aos.customview.CustomRelativeLayout>

                </RelativeLayout>




                <LinearLayout
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:minWidth="240dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="30dp"
                    >

                    <TextView
                        android:id="@+id/rateTextView"
                        android:gravity="center"
                        android:drawableStart="@drawable/inno_rate_icon_17"
                        android:drawablePadding="6dp"
                        android:layout_gravity="center"
                        android:textColor="@color/black2"
                        android:textSize="18dp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="700"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rate"/>

                    <com.example.hstm_aos.customview.GradientFanView
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:id="@+id/speed_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        />

                </LinearLayout>


                <LinearLayout
                    android:layout_marginStart="30dp"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/volumeTextView"
                        android:gravity="center"
                        android:drawableStart="@drawable/inno_vent_icon_17"
                        android:drawablePadding="6dp"
                        android:layout_gravity="center"
                        android:textColor="@color/black2"
                        android:textSize="18dp"
                        android:fontFamily="@font/custom_font"
                        android:textFontWeight="700"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Volume"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                    <com.example.hstm_aos.customview.VentCustomView
                        android:id="@+id/vent_view"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        />


<!--                        <ImageView-->

<!--                            android:layout_width="match_parent"-->
<!--                            android:layout_height="match_parent"-->
<!--                            android:src="@drawable/inno_vent_background"/>-->

                    </RelativeLayout>
                </LinearLayout>

            </com.example.hstm_aos.customview.RoundedLinearLayout>




        </LinearLayout>
    </LinearLayout>

</LinearLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:layout_marginBottom="50dp">

        <com.example.hstm_aos.customview.RoundedLinearLayout
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="30dp"
            android:paddingTop="15dp"
            android:paddingEnd="30dp"
            android:paddingBottom="15dp"
            android:visibility="invisible"
            app:rv_radius="100dp"
            app:rv_backgroundColor="@color/black"
            app:rv_borderWidth="0dp">

            <ImageView
                android:id="@+id/cycleInfoImageView"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/inno_cycle_check_toast_icon"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cycleTextview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:text=""
                android:textColor="@color/white"
                android:textSize="24dp" />


        </com.example.hstm_aos.customview.RoundedLinearLayout>
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/button"
            android:layout_toRightOf="@id/button"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingLeft="16dp"
            android:text=""
            android:textSize="18sp"
            android:visibility="gone" />
    </RelativeLayout>


</RelativeLayout>